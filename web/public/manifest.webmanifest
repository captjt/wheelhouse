{
  "name": "Wheelhouse",
  "short_name": "Wheelhouse",
  "description": "Every piece of agent work as a docket, on a record you can check.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#101113",
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [{ "name": "images", "accept": ["image/png", "image/jpeg", "image/gif", "image/webp", "image/heic", "image/heif", "image/avif"] }]
    }
  }
}
