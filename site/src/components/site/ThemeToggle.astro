---
// System, Light or Dark, as in the app. It shares Starlight's setting
// ("starlight-theme"), so the landing page and the docs agree.
---

<wh-theme class="wh-theme" role="group" aria-label="Theme">
  <button type="button" aria-pressed="false" data-pick="auto" aria-label="System" title="System">
    <svg viewBox="0 0 16 16" aria-hidden="true"><rect x="2" y="3" width="12" height="8" rx="1.5"></rect><path d="M6 13.5h4"></path></svg>
  </button>
  <button type="button" aria-pressed="false" data-pick="light" aria-label="Light" title="Light">
    <svg viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="2.8"></circle><path d="M8 1.5v1.5M8 13v1.5M1.5 8H3M13 8h1.5M3.4 3.4l1 1M11.6 11.6l1 1M3.4 12.6l1-1M11.6 4.4l1-1"></path></svg>
  </button>
  <button type="button" aria-pressed="false" data-pick="dark" aria-label="Dark" title="Dark">
    <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M13 9.5A5.5 5.5 0 0 1 6.5 3a5.5 5.5 0 1 0 6.5 6.5Z"></path></svg>
  </button>
</wh-theme>

<script>
  const KEY = "starlight-theme";
  const read = () => {
    try {
      const t = localStorage.getItem(KEY);
      return t === "light" || t === "dark" ? t : "auto";
    } catch {
      return "auto";
    }
  };
  const apply = (pick: string) => {
    const dark = pick === "dark" || (pick === "auto" && !matchMedia("(prefers-color-scheme: light)").matches);
    document.documentElement.dataset.theme = dark ? "dark" : "light";
  };
  class Theme extends HTMLElement {
    connectedCallback() {
      const mark = (pick: string) =>
        this.querySelectorAll<HTMLButtonElement>("[data-pick]").forEach((b) =>
          b.setAttribute("aria-pressed", String(b.dataset.pick === pick)),
        );
      mark(read());
      this.addEventListener("click", (e) => {
        const b = (e.target as Element).closest<HTMLButtonElement>("[data-pick]");
        if (!b?.dataset.pick) return;
        try {
          localStorage.setItem(KEY, b.dataset.pick === "auto" ? "" : b.dataset.pick);
        } catch {}
        apply(b.dataset.pick);
        mark(b.dataset.pick);
      });
      matchMedia("(prefers-color-scheme: light)").addEventListener("change", () => {
        if (read() === "auto") apply("auto");
      });
    }
  }
  customElements.define("wh-theme", Theme);
</script>
