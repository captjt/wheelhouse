---
// A desktop screenshot in a window: a title bar with the traffic lights, and
// the capture at full resolution below it.
import Pic from "../Pic.astro";

interface Props {
  name: string;
  alt: string;
  title?: string;
  sizes?: string;
  class?: string;
}
const { name, alt, title = "Wheelhouse", sizes = "(min-width: 75rem) 72rem, 100vw", class: cls } = Astro.props;
---

<figure class:list={["wh-window", cls]}>
  <div class="wh-window-bar" aria-hidden="true">
    <span class="wh-dots"><i></i><i></i><i></i></span>
    <span class="wh-window-title">{title}</span>
  </div>
  <Pic name={name} alt={alt} sizes={sizes} />
</figure>
