---
// The wheel, as the app draws it (web/src/icons.tsx), in Cloudflare orange.
interface Props {
  size?: number;
}
const { size = 22 } = Astro.props;
---

<svg width={size} height={size} viewBox="0 0 32 32" aria-hidden="true" class="wh-logo">
  <circle cx="16" cy="16" r="11" fill="none" stroke="currentColor" stroke-width="3.2"></circle>
  <circle cx="16" cy="16" r="3.4" fill="currentColor"></circle>
  {[0, 60, 120, 180, 240, 300].map((a) => (
    <line x1="16" y1="2" x2="16" y2="5.5" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" transform={`rotate(${a} 16 16)`} />
  ))}
</svg>
