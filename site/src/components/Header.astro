---
// The docs' top bar, the landing page's in Starlight: the wheel, search,
// where to go, the theme, and Get started.
import Search from "@astrojs/starlight/components/Search.astro";
import SiteTitle from "./SiteTitle.astro";
import ThemeSelect from "@astrojs/starlight/components/ThemeSelect.astro";

const links = [
  { href: "/start/introduction/", label: "Guides", match: ["/start/", "/concepts/"] },
  { href: "/features/inbox-chat/", label: "Protocols", match: ["/features/"] },
  { href: "/apps/mac/", label: "Apps", match: ["/apps/"] },
  { href: "/teams/overview/", label: "Teams", match: ["/teams/"] },
  { href: "/reference/cli/", label: "Reference", match: ["/reference/"] },
];
const here = Astro.url.pathname;
---

<div class="wh-hdr">
  <div class="wh-hdr-title"><SiteTitle /></div>
  <nav class="wh-hdr-nav" aria-label="Sections">
    {
      links.map((l) => (
        <a href={l.href} aria-current={l.match.some((m) => here.startsWith(m)) ? "true" : undefined}>
          {l.label}
        </a>
      ))
    }
  </nav>
  <div class="wh-hdr-search print:hidden"><Search /></div>
  <div class="wh-hdr-end print:hidden">
    <a class="wh-hdr-icon" href="https://github.com/captjt/wheelhouse" aria-label="Wheelhouse on GitHub">
      <svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"></path></svg>
    </a>
    <ThemeSelect />
    <a class="wh-hdr-cta" href="/start/install/">Get started</a>
  </div>
</div>
