#!/usr/bin/env python3
# A stand-in for the Listener (src/calls.rs) in the made-up world: it reads
# the prompt as Claude Code would, finds the dockets it names by their
# titles, and answers with what the demo call settled, as `claude -p
# --output-format json` does. Never a model: the screenshots stay the same.
import json
import re
import sys

prompt = sys.stdin.read()


def id_of(title):
    m = re.search(r"^- (D-\d+): .*" + re.escape(title), prompt, re.M)
    return m.group(1) if m else None


own = re.search(r"\A<docket>\n(D-\d+): ", prompt)
proposals = []
if own:
    # A call on the webhooks docket: its intent, revised, keeps every part
    # the call didn't change.
    m = re.search(r"\nIntent \(version \d+\):\n(.*?)\n\n(?:Decisions in force:|Agents on it:)", prompt, re.S)
    intent = m.group(1) if m else ""
    item = "- [ ] A delivery that runs out of tries goes to the dead-letter queue"
    lines = intent.split("\n")
    last = max((i for i, l in enumerate(lines) if l.startswith("- [")), default=len(lines) - 1)
    revised = "\n".join(lines[: last + 1] + [item] + lines[last + 1 :])
    proposals += [
        {"kind": "decide", "docket": None, "subject": "Retries", "choice": "5xx and timeouts only, at most 3 tries",
         "quote": "Retries are 5xx and timeouts only, and three tries at most.", "why": "Settled on the call, for this docket's retries."},
        {"kind": "intent", "docket": None, "subject": "A delivery that runs out of tries goes to the dead-letter queue", "intent": revised,
         "quote": "Anything that runs out of tries goes to the dead-letter queue. Put that in the spec.", "why": "The call added it to what done means."},
        {"kind": "instruct", "docket": None, "text": "Send deliveries that run out of tries to the dead-letter queue, with a test for it.",
         "quote": "Anything that runs out of tries goes to the dead-letter queue.", "why": "It's the next piece of this docket's work."},
    ]
checkout = id_of("checkout tests")
if checkout:
    proposals.append({"kind": "ask", "docket": checkout, "question": "Should the cart test cover a bundle that is also on sale?", "options": ["Yes, add it", "No, out of scope"],
                      "quote": "Can the checkout agent tell us whether the cart test covers a bundle on sale?", "why": "The checkout tests are that docket."})
proposals.append({"kind": "task", "title": "Write the runbook for the webhook outage page",
                  "intent": "On-call can follow a runbook when webhook deliveries fail.\n\n## Acceptance\n- [ ] The runbook says how to replay failed deliveries\n- [ ] It is linked from the outage page",
                  "quote": "Somebody should write the runbook for the outage page before Friday.", "why": "Separate work no open docket covers."})
print(json.dumps({
    "type": "result", "subtype": "success", "is_error": False, "session_id": "demo-listener", "total_cost_usd": 0.04,
    "usage": {"input_tokens": 4210, "cache_read_input_tokens": 0, "cache_creation_input_tokens": 0, "output_tokens": 612},
    "structured_output": {"proposals": proposals},
}))
